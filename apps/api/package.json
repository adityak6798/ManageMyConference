{
  "name": "@greenroom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../tools/local-wrangler.mjs build",
    "deploy": "wrangler deploy",
    "dev": "node ../../tools/local-wrangler.mjs dev",
    "migrate:local": "node ../../tools/local-wrangler.mjs migrate",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "reset": "node ../../tools/local-wrangler.mjs reset",
    "test": "vitest run --coverage --coverage.reporter=text --coverage.include='src/**'",
    "test:d1": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@greenroom/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.7.0",
    "papaparse": "^5.5.4",
    "sanitize-html": "^2.17.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/sanitize-html": "^2.16.1",
    "miniflare": "5.20260801.1-alpha",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.30.0"
  }
}
