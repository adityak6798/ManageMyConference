    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@greenroom/contracts": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.0",
    "vitest": "^3.0.0"
  }
}
