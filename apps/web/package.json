{
  "name": "@greenroom/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port ${GREENROOM_WEB_PORT:-5173}",
    "build": "vite build",
    "test:e2e": "playwright test",
