{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "greenroom-webhook-egress",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "secrets": {
    "required": ["WEBHOOK_EGRESS_TOKEN"]
  },
  "containers": [
    {
      "class_name": "WebhookEgressContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBHOOK_EGRESS_CONTAINER",
        "class_name": "WebhookEgressContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebhookEgressContainer"]
    }
  ]
}
