  "architecture": {
    "publicApplicationEntryPoints": [
      {
        "path": "packages/contracts/src/domains/platform.ts",
        "governing": "ARC-DOM-001",
        "reason": "The platform-owned HTTP contract vocabulary: every response shares its declared API version and collection domains reuse its cursor-page schemas instead of drifting transport mechanics. It contains no business-domain nouns or behavior."
      },
      {
        "path": "apps/api/src/adapters/persistence/d1-write-result.ts",
        "governing": "ARC-003",
        "reason": "The transport-wide D1 write-result contract. Persistence adapters share its required affected-row count and refusal helper so a missing driver count has one meaning, while the module contains no domain logic or table knowledge."
      },
      {
        "path": "apps/api/src/application/events/event-service.ts",
        "governing": "ARC-DOM-001",
        "reason": "Every domain that must know an event exists, or who organizes it, asks this service: review resolves event membership through it and the transport composes it."
      },
      {
        "path": "apps/api/src/application/events/public.ts",
        "governing": "ARC-DOM-001",
        "reason": "The events domain's declared export surface, and the slice port a template is assembled from. Five domains import EventConfigurationSlice from it \u2014 review, cfp, agenda, publishing and content, whose two slices bring the file count to six \u2014 each targeting the surface instead of deep-importing the service, which is what it was declared for."
      },
      {
        "path": "apps/api/src/application/platform/public.ts",
        "governing": "ARC-DOM-001",
        "reason": "The platform domain's declared export surface: the operational service the transport composes and the vocabulary its cross-domain answers are written in. No cross-domain import reaches it today \u2014 platform composes other domains rather than being composed \u2014 and it stays declared for the same reason events/public.ts does, so a later consumer has a surface to target instead of deep-importing the service."
      },
      {
        "path": "apps/api/src/application/cfp/public.ts",
        "governing": "ARC-DOM-001",
        "reason": "CFP's declared export surface: the service type and the three errors the transport translates into 400 and 404 responses."
      },
      {
        "path": "apps/api/src/application/identity/actor.ts",
        "governing": "PRD-IAM-002",
        "reason": "The capability model and the two authorization errors. Every domain's route module and four application services enforce authorization through it, which makes it the one identity surface the whole repository depends on."
      },
      {
        "path": "apps/api/src/application/identity/demo-session.ts",
        "governing": "PRD-IAM-001",
        "reason": "Harness-only session issue and resolution. The transport middleware resolves the session cookie through it and the identity routes issue one."
      },
      {
        "path": "apps/api/src/application/identity/real-auth.ts",
        "governing": "PRD-IAM-001",
        "reason": "Production session and event-token issue and verification. The platform transport resolves credentials through this identity application boundary."
      },
      {
        "path": "apps/api/src/application/identity/membership.ts",
        "governing": "PRD-IAM-002",
        "reason": "Organization membership and event-role administration, and this domain's command surface for it. The transport holds the service the way it holds CrmService and ReviewService, and its typed refusals are what the identity route module's translateError maps; the three-condition organization authorization and the demo-persona guard stay behind it."
      },
      {
        "path": "apps/api/src/application/identity/session-store.ts",
        "governing": "PRD-IAM-001",
        "reason": "The record of an issued session \u2014 the same boundary as real-auth.ts, for the same reason. The platform transport holds this behaviour object in its auth configuration and checks every session cookie against it, while the D1 implementation and the signing secret stay behind it. It is a port of four methods with no storage detail on it, which is what makes it an interface rather than a reach into identity's internals."
      },
      {
        "path": "apps/api/src/application/identity/identity-directory.ts",
        "governing": "PRD-IAM-002",
        "reason": "The directory CRM, review and the content speaker-conversion adapter resolve personas and event membership through, instead of reading membership tables."
      },
      {
        "path": "apps/api/src/application/identity/public.ts",
        "governing": "ARC-DOM-001",
        "reason": "Identity-access's declared machine-credential application surface. The transport composition contract depends on the service type through this module while credential policy, hashing, resolution, and persistence stay inside identity-access."
      },
      {
        "path": "apps/api/src/application/communications/public.ts",
        "governing": "PRD-COM-001",
        "reason": "Communications' declared export surface: the enqueue interface a lifecycle event uses when there is no request actor, the prepared-delivery writer a caller commits in its own batch, the service type the transport composes, and the three typed errors both translate. Narrowed from communications-service.ts, which #92 recorded as the one entry naming a service instead of an export surface."
      },
      {
        "path": "apps/api/src/application/content/content-service.ts",
        "governing": "PRD-SPK-001",
        "reason": "Content's command surface, plus the speaker-identity and photo errors that review's route module translates when acceptance provisions a speaker."
      },
      {
        "path": "apps/api/src/application/content/public.ts",
        "governing": "ARC-FLOW-001",
        "reason": "Content's declared read interface. Agenda and publishing compose session content through it rather than reading content's tables."
      },
      {
        "path": "apps/api/src/application/cfp/submitted-proposal-interface.ts",
        "governing": "ARC-FLOW-001",
        "reason": "The reference review uses to reach a submitted proposal without reading cfp_submissions."
      },
      {
        "path": "apps/api/src/application/review/review-service.ts",
        "governing": "PRD-REV-001",
        "reason": "Review's command surface and its three typed errors, composed by the transport."
      },
      {
        "path": "apps/api/src/application/review/public.ts",
        "governing": "ARC-FLOW-001",
        "reason": "Review's declared outcome interface: content asks it whether a proposal was accepted before provisioning a speaker."
      },
      {
        "path": "apps/api/src/application/crm/public.ts",
        "governing": "PRD-CRM-001",
        "reason": "CRM's declared surface and its four typed errors, composed by the transport."
      },
      {
        "path": "apps/api/src/application/content/speaker-conversion.ts",
        "governing": "ARC-FLOW-001",
        "reason": "The command CRM issues to turn a prospect into a speaker, so conversion crosses the boundary as a call rather than a write into content's tables."
      },
      {
        "path": "apps/api/src/application/agenda/public.ts",
        "governing": "PRD-AGD-001",
        "reason": "Agenda's declared schedule interface. Content reads session times through it and publishing composes the public schedule from it."
      },
      {
        "path": "apps/api/src/application/publishing/public.ts",
        "governing": "PRD-PUB-001",
        "reason": "Publishing's declared surface: the service type and composePublicSchedule, which the transport uses to build the public schedule response."
      },
      {
        "path": "apps/web/src/PublicEventApp.tsx",
        "governing": "PRD-PUB-001",
        "reason": "The public site's root component. main.tsx mounts it for /events/*, which is the only cross-domain reach into publishing's UI."
      },
      {
        "path": "apps/web/src/api/cfp.ts",
        "governing": "PRD-CFP-002",
        "reason": "The public CFP client. The public site renders the applicant form and submits through it, which is the one place publishing's UI calls CFP's API."
      },
      {
        "path": "apps/web/src/api/identity.ts",
        "governing": "ARC-DOM-001",
        "reason": "The browser's identity client \u2014 who this document is, which doors the deployment offers, and the four ways through them \u2014 and the same kind of surface as api/cfp.ts one entry above. Three unrelated roots read it: the console shell, the landing page, and the public CFP, which offers a submitter a way to sign in so their drafts and decisions belong to an account (issue #190). It was already declared its own module rather than living in api/events.ts precisely because the landing page must not import the console's domain client; the public bundle has the same constraint and the same need. It holds no session state and no capability logic \u2014 the httpOnly cookie means only the API can answer either question."
      },
      {
        "path": "apps/web/src/api/config.ts",
        "governing": "ARC-001",
        "reason": "The browser transport's shared origin and fetch adapter. Every domain API client uses it so development proxying, same-origin deployment, and optional split hosting resolve requests consistently."
      },
      {
        "path": "apps/web/src/ui/primitives.tsx",
        "governing": "ARC-DOM-001",
        "reason": "The design system. Eight domains' workspaces render through the same Card, Notice, EmptyState and PageHeader, which is what makes the console read as one product."
      },
      {
        "path": "apps/web/src/ui/icons.tsx",
        "governing": "ARC-DOM-001",
        "reason": "The design system's icon set, imported by every workspace module and by the shell's navigation."
      },
      {
        "path": "apps/api/src/transport/http/runtime.ts",
        "governing": "ARC-001",
        "reason": "The transport's shared vocabulary: the request context type, the error envelope, the validation-field helper and the JSON reader. Every domain route module imports it and it holds no domain logic."
      },
      {
        "path": "apps/api/src/transport/http/routes/contract.ts",
        "governing": "ARC-DOM-001",
        "reason": "The route-module interface and the named dependency set every domain route module implements."
      },
      {
        "path": "apps/api/src/transport/http/throttle.ts",
        "governing": "PRD-CFP-002",
        "reason": "Address-derived submission throttling. CFP's public submission route is its only consumer, but the throttle is transport infrastructure rather than CFP's rule, so it stays platform-owned."
      },
      {
        "path": "apps/web/src/workspaces/contract.ts",
        "governing": "ARC-DOM-001",
        "reason": "The workspace-module interface every domain's console surface implements."
      },
      {
        "path": "packages/contracts/src/domains/identity-access.ts",
        "governing": "PRD-IAM-002",
        "reason": "The wire half of the authorization vocabulary. fieldPolicyEntrySchema states what a per-field View/Lock/Hide decision looks like on the wire, and a domain whose projection can be narrowed by one has to name it in its own response \u2014 content's workspace does, and the CRM directory follows. It is the same shared-surface argument application/identity/actor.ts already carries: every domain enforces authorization through identity's vocabulary rather than restating it, and two copies of a policy enum is how one surface comes to permit what another refuses."
      }
    ],
    "compositionRoots": [
