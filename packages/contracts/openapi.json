              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actor": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "persona": {
                          "type": "string",
                          "enum": [
                            "organizer",
                            "reviewer",
                            "speaker",
                            "public"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "persona"
                      ]
                    },
                    "organizations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ]
                      }
                    },
                    "eventAccess": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "eventId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "organizer",
                              "reviewer",
                              "speaker",
                              "public"
                            ]
                          },
                          "capabilities": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "events:read",
                                "events:create",
                                "events:settings:read",
                                "events:settings:update"
                              ]
                            }
                          }
                        },
                        "required": [
                          "eventId",
                          "role",
                          "capabilities"
                        ]
                      }
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "events:read",
                          "events:create",
                          "events:settings:read",
                          "events:settings:update"
                        ]
                      }
                    }
