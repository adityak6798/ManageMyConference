{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.venv",
      "!**/.wrangler",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results",
      "!**/openapi.json",
      "!apps/webhook-egress/worker-configuration.d.ts",
      "!context-manifest.json",
      "!prototype.html",
      "!.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noEmptyBlockStatements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
